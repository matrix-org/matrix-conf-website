---

<style>
    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    h2 {
        color: var(--secondary-color);
        font-size: 0.875rem;
        text-transform: uppercase;
	}

	.supporter-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto;
        border: 1px solid #636569;
        gap: 1px;
        background-color: var(--bg-color);

        > a {
            display: grid;
            padding: 20px;
            gap: 4px;
            box-shadow: 0 0 0 1px #636569; /* box-shadow is used to achieve a border-collapse effect within the grid */
            font-size: 1.125rem;
            text-decoration: none;

            &:hover {
                text-decoration: none;
            }
        }
	}

	.supporter {
		place-content: center;
	}

    @media (max-width: 625px) {
		.supporter-grid {
            grid-template-columns: 1fr;
		}
    }
</style>

<div class="content-wrapper">
	<h2>Supporters</h2>
	<div class="supporter-grid">
        <a
            id="Aalborg University"
            class="supporter"
            href="https://www.en.aau.dk"
            target="_blank"
        >
            <img src="/supporters/aalborg-university.svg" alt="Aalborg University" />
        </a>
        <a
            id="Futurewei"
            class="supporter"
            href="https://www.futurewei.com"
            target="_blank"
        >
            <img src="/supporters/futurewei.svg" alt="Futurewei" />
        </a>
	</div>
</div>
