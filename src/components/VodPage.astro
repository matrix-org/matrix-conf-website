---
import SponsorsGrid from "../components/SponsorsGrid.astro";
import WatchCard from "../components/WatchCard.astro";
import Pill from "../components/Pill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const talks_collection = await getCollection("talks");
const all_talks = talks_collection.toSorted((a,b) => new Date(a.data.Start).valueOf() - new Date(b.data.Start).valueOf());

// Talks are grouped by their calendar date in the time zone of the event.
const timeZone = "Europe/Stockholm";
const isoDate = new Intl.DateTimeFormat("sv-SE", { timeZone }); // YYYY-MM-DD
const headingParts = new Intl.DateTimeFormat("en-GB", { timeZone, weekday: "long", day: "numeric", month: "long" });

function dayHeading(start: Date) {
    const parts = Object.fromEntries(headingParts.formatToParts(start).map((part) => [part.type, part.value]));
    return { weekday: parts.weekday, day: Number(parts.day), month: parts.month };
}

function ordinalSuffix(date:number) {
    if (date % 100 >= 11 && date % 100 <= 13) return 'th';
    return ({ 1: 'st', 2: 'nd', 3: 'rd' } as {[index: number]: string})[date % 10] ?? 'th';
}

const track_order : {[index: string]:number} = Object.freeze({
    "Keynote": 0,
    "Public Sector": 1,
    "Public Sector sponsored by Element": 2,
    "Healthcare sponsored by CGM": 3,
    "Cryptography": 4,
    "Matrix Inside": 5,
    "In Practice": 6,
    "Digital Sovereignty": 7,
    "Growing a Network": 8,
    "Next Gen Spec": 9,
    "Foundation": 10,
    "Lightning Talks": 11
});

function compareTrack(a: CollectionEntry<"talks">,b: CollectionEntry<"talks">) {
    if (a.data.Track === undefined) return 1;
    if (b.data.Track === undefined) return -1;
    return (track_order[a.data.Track.en] ?? Infinity) - (track_order[b.data.Track.en] ?? Infinity) || 0;
}

const byDay = Map.groupBy(all_talks, (talk) => isoDate.format(new Date(talk.data.Start)));
const days = [...byDay.values()].map((day) => ({
    talks: day.toSorted(compareTrack),
    ...dayHeading(new Date(day[0].data.Start)),
}));
---

<style lang="scss">
    section {
        padding: clamp(2.5rem, 10vw, 5rem) 1.5rem;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    .content-wrapper#talks {
        max-width: 1122px;
    }

    h1 {
        font-size: 2.5rem;
        line-height: 120%;
        text-align: center;
    }

    h2 {
        font-size: 2rem;
        color: var(--fg-color);
        font-size: 2rem;
        line-height: 120%;
    }

    a {
        color: var(--link-color);
        text-decoration: none;
    }

    #filters {
        display: flex;
        flex-wrap: wrap;
        gap: .5em;
        justify-content: center;
    }

    .date-separator {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 48px;
        margin-bottom: 24px;

        .date {
            flex: none;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-secondary)
        }

        .line {
            flex: 1;
            height: 0px;
            border-top: 2px solid var(--border);
        }
    }

    .talks-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        row-gap: 48px;
        column-gap: 24px;
    }

    #info {
        background-image: url(/grey-repeating-lines.svg);
    }

    .hidden {
        display: none;
    }

    .empty-section {
        color: var(--text-secondary);
        font-size: 1.25rem;
        text-align: center;
    }

    @media (min-width: 768px) {
        .empty-section {
            font-size: 2rem;
            margin-bottom: 48px;
        }
    }
</style>

<style is:global>
    #filters .active {
        border: 2px solid white;
    }

    .no-js {
        display: none !important;
    }
</style>

<BaseLayout
    pageTitle="Watch the Conference Recordings"
    description="Follow along the Matrix Conference even if you couldn't make it to Malmö"
>
    <section id="hero">
        <div class="content-wrapper">
            <h1>Watch the talks</h1>
        </div>
    </section>

    <section id="recordings">
        {days.length === 0 ? (
        <div class="content-wrapper">
            <p class="empty-section">The recordings will be available here soon.</p>
        </div>
        ) : (<>
        <div class="content-wrapper no-js">
            <div id="filters">
                <Pill Type="button" label="Keynote" />
                <Pill Type="button" label="Public Sector" />
                <Pill Type="button" label="Public Sector sponsored by Element" />
                <Pill Type="button" label="Healthcare sponsored by CGM" />
                <Pill Type="button" label="Cryptography" />
                <Pill Type="button" label="Matrix Inside" />
                <Pill Type="button" label="In Practice" />
                <Pill Type="button" label="Digital Sovereignty" />
                <Pill Type="button" label="Growing a Network" />
                <Pill Type="button" label="Next Gen Spec" />
                <Pill Type="button" label="Foundation" />
                <Pill Type="button" label="Lightning Talks" />
            </div>
        </div>
        <div class="content-wrapper" id="talks">
            {days.map((day) => (
            <div class="date-separator">
                <div class="date">{day.weekday}{" "}{day.day}<sup>{ordinalSuffix(day.day)}</sup>{" "}{day.month}</div>
                <div class="line"></div>
            </div>
            <div class="hidden empty-section">
                There are no talks for this day that match the filters.
            </div>
            <div class="talks-grid">
                {day.talks.map((talk) => (
                    <WatchCard talk={talk} />
                ))}
            </div>
            ))}
        </div>
        </>)}
    </section>

    <section id="info">
        <div class="content-wrapper">
            <p>
                All recordings are available on <a
                    href="https://media.ccc.de/c/matrix-conf-2026"
                    >media.ccc.de</a> and <a
                    href="https://www.youtube.com/playlist?list=PLFDUAtPqCX98"
                    >YouTube</a>.
            </p>
            <p>
                All videos and slides linked or published here are available under <a
                    href="https://creativecommons.org/licenses/by-sa/4.0/"
                >CC BY-SA 4.0</a>.
            </p>
        </div>
    </section>

    <section id="sponsors">
        <SponsorsGrid />
    </section>
</BaseLayout>

<script>
    // Elements, that require JavaScript to work have the "no-js" class.
    // This class sets display = none.
    // In <script> the class is removed, so that the elements show up.
    const removeNoJs = () => {
        document.querySelectorAll('.no-js').forEach((element) => {
            element.classList.remove("no-js")
        })
    }
    removeNoJs();

    // Filter logic
    type TalkSection = {
        emptySectionElement: HTMLElement;
        talksGrid: HTMLElement;
        talkElements: HTMLElement[];
    }

    const talksElement = document.getElementById("talks");
    let talkSections : TalkSection[] = [];

    if (talksElement !== null) {
        // Find triples of empty section elements, talks grid and the talk elements inside of the grid
        let emptySectionElement : HTMLElement | null = null;

        Array.from(talksElement.children).forEach((talkElement) => {
            if (!(talkElement instanceof HTMLElement)) {
                return;
            }

            if (talkElement.classList.contains("empty-section")) {
                emptySectionElement = talkElement;
            }

            if (talkElement.classList.contains("talks-grid") && emptySectionElement !== null) {
                talkSections.push({
                    emptySectionElement,
                    talksGrid: talkElement,
                    talkElements: Array.from(talkElement.children).filter((element) => element instanceof HTMLElement),
                });
                emptySectionElement = null;
            }
        })
    }

    const filterPillElements = document.querySelectorAll("#filters .pill")
    const talkElements = document.querySelectorAll<HTMLElement>("#recordings .talk-card")

    const getActiveTracks = (): string[] => {
        const activePills = Array.from(filterPillElements)
            .filter(pill => pill.classList.contains("active"));
        return activePills.map((pill) => {
            return Array.from(pill.classList.values())
                .filter(cls => cls !== "pill" && cls !== "active")[0];
        })
    }

    const applyFilters = () => {
        const activeTracks = getActiveTracks();
        talkElements.forEach((recordingElement) => {
            if (
                // No filter active
                activeTracks.length === 0
                // Track class is in active tracks
                || activeTracks.some(activeTrack => recordingElement.classList.contains(activeTrack))) {
                recordingElement.style.display = 'flex'
                return;
            }

            recordingElement.style.display = 'none';
        });

        // Set element visibilities.
        // If a day does not have at least one talk then
        // hide the talks grid and display a placeholder.
        talkSections.forEach((talkSection) => {
            const allHidden = talkSection.talkElements.every((talkElement) => {
                return talkElement.style.display === 'none';
            });

            talkSection.emptySectionElement.style.display = allHidden ? 'block' : 'none';
            talkSection.talksGrid.style.display = allHidden ? 'none' : 'grid';
        });
    }

    const handleFilterPillClicked = (event: Event) => {
        const target = event.currentTarget as HTMLElement;
        target.classList.toggle("active");
        applyFilters();
    }

    const setUpTracksFilter = () => {
        filterPillElements.forEach((filterPill) => {
            filterPill.addEventListener("click", handleFilterPillClicked);
        })
    }

    setUpTracksFilter();
</script>
