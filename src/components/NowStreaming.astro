---
// "Now streaming" / "Up next" for one room, from the live pretalx schedule.
import "../styles/schedule.css"; // avatar and speaker styles
import Now from "./schedule/NowStreaming";
interface Props {
    /** Pretalx room id to show the current or next talk of. */
    room: number;
}
const { room } = Astro.props;
---

<style is:global>
    .now {
        position: relative;
        padding-inline-start: 1rem;
        min-height: 3.5rem;
    }
    .now::before {
        content: "";
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: 4px;
        background: var(--track, #636569);
    }
    .now[data-keynote]::before {
        background: var(--rainbow);
    }
    .label {
        color: var(--secondary-color);
        font-size: 0.875rem;
        text-transform: uppercase;
    }
    .label.live {
        color: var(--link-color);
        font-weight: 700;
    }
    .now .track {
        display: block;
        margin-top: 0.5rem;
        color: var(--track);
        font-size: 0.875rem;
        font-weight: 700;
    }
    .then {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid #3c3f44;
        font-size: 0.875rem;
    }
    .then .label {
        margin-inline-end: 0.5rem;
        color: var(--link-color);
        font-weight: 700;
    }
    .now a {
        color: var(--fg-color);
        text-decoration: none;
    }
    .now a:hover {
        text-decoration: underline;
    }
    .title {
        font-weight: 700;
    }
    .when,
    .who {
        color: var(--secondary-color);
        font-size: 0.875rem;
    }
    .now .who {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }
</style>
<div aria-live="polite">
    <Now client:only="preact" room={room} />
</div>
