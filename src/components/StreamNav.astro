---
// Stream picker shared by /watch and /watch/<room>. `current` is a room slug, or omitted for the overview.
import { streams } from "../data/streams";
interface Props { current?: string; }
const { current } = Astro.props;
const items = [{ href: "/watch", name: "All streams", active: !current }, ...streams.map((s) => ({ href: `/watch/${s.slug}`, name: s.name, active: s.slug === current }))];
---

<style>
    nav { display: flex; flex-wrap: wrap; justify-content: center; }
    a { position: relative; padding: 0.75rem 1.5rem; border: 1px solid #636569; margin-inline-start: -1px; color: var(--fg-color); font-weight: 700; text-decoration: none; }
    a:hover { background-color: #262626; }
    a[aria-current="page"] { background-color: #1a1a1a; }
    /* Current place gets the rainbow highlight; link blue is for places you can go to. */
    a[aria-current="page"]::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, #f45b69 5%, #f6ae2d 30%, #a6ffa1 50%, #75f4f4 70%, #ae7fe9 95%); }
    @media (max-width: 600px) {
        nav { display: grid; grid-template-columns: 1fr 1fr; }
        a { margin-inline-start: 0; margin-block-start: -1px; text-align: center; }
        a:nth-child(even) { margin-inline-start: -1px; }
    }
</style>
<nav aria-label="Streams">
    {items.map((i) => <a href={i.href} aria-current={i.active ? "page" : undefined}>{i.name}</a>)}
</nav>
