---
import PrimaryCta from "./PrimaryCta.astro";
---

<style>
    .content-wrapper {
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    .items {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 2rem;
    }

    .item {
        border: 1px solid #636569;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        padding: 1rem;
    }

    .actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    @media (min-width: 800px) {
        .actions {
            flex-direction: row;
            margin-top: auto;
            width: fit-content;
        }
    }

    .smol {
        @media (min-width: 800px) {
            flex-basis: 40%;
        }
    }

    .highlight {
        border: 1px solid;
        border-image: linear-gradient(
            314deg,
            #f45b69 15.02%,
            #f6ae2d 32.83%,
            #a6ffa1 50.64%,
            #75f4f4 68.44%,
            #ae7fe9 86.25%
        ) 30;
    }

    h2 {
        font-size: 2rem;
        font-weight: 700;
    }

    p {
        font-size: 1.125rem;
        margin-block: 1rem;
    }
</style>
<div class="content-wrapper">
    <div class="items">
        <div class="item highlight smol">
            <h2>Attend</h2>
            <p>
                The Conference travels to Scandic Triangeln in Malmö in 2026.
                Learn all about the venue, how to get there, where to stay,
                and any partner offers available with your #MatrixConf ticket.
            </p>
            <div class="actions">
                <PrimaryCta
                    href="/attend"
                    flexBottom={true}
                >
                    Practical Info
                </PrimaryCta>
                <PrimaryCta
                    href="/register"
                    flexBottom={true}
                >
                    Tickets
                </PrimaryCta>
            </div>
        </div>
        <div class="item smol">
            <h2>Become a Sponsor</h2>
            <p>Step into the spotlight and join us as a valued sponsor of The Matrix Conference 2026.</p>
            <PrimaryCta
                href="/sponsor"
                flexBottom={true}
            >
                Sponsor
            </PrimaryCta>
        </div>
        <div class="item smol">
            <h2>Hackathon</h2>
            <p>
                Join us at Aalborg University for a hackathon on 23rd October, 2026.
            </p>
            <PrimaryCta
                href="/hackathon"
                flexBottom={true}
            >
            Learn more
            </PrimaryCta>
        </div>
        <div class="item smol">
            <h2>Join the Chat</h2>
            <p>Connect and exchange with other attendees and the organising team.</p>
            <PrimaryCta
                href="https://matrix.to/#/#events-wg:matrix.org"
                flexBottom={true}
            >
            #events-wg:matrix.org
            </PrimaryCta>
        </div>
    </div>
</div>
