---
// Overview of every livestream: one card per room with what is on now, plus links to the chat and the Matrix space.
import RoomName from "./RoomName.astro";
import ChatLinks from "./ChatLinks.astro";
import NowStreaming from "./NowStreaming.astro";
import { streams, cccStream, matrixTo } from "../data/streams";

interface Props {
    /** Whether to show the link to join the Matrix space below the cards. */
    space?: boolean;
}
const { space = true } = Astro.props;
---

<style>
    .overview {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }
    .card {
        border: 1px solid #636569;
        display: flex;
        flex-direction: column;
        background: #000;
    }
    .card .banner {
        aspect-ratio: 16 / 9;
        display: grid;
        place-content: center;
        background: url(/grey-repeating-lines.svg) center / cover;
        text-decoration: none;
    }
    .card .banner h2 {
        background: #000;
        padding: 0.5rem 1.5rem;
        font-size: 1.75rem;
        margin: 0;
    }
    .card .info {
        padding: 24px;
        flex-grow: 1;
    }
    .card .row {
        border-top: 1px solid #636569;
    }
    .card .row a {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 3.5rem;
        padding-inline: 24px;
        color: var(--link-color);
        text-decoration: none;
    }
    .card .row a:hover {
        background-color: #262626;
    }
    .card .row img {
        flex: none;
        width: 24px;
        height: 24px;
    }
    .card .banner:hover h2 {
        background: #262626;
    }
</style>
<div class="overview">
    <div class="cards">
        {streams.map((s) => (
            <div class="card">
                <a
                    class="banner"
                    href={`/watch/${s.slug}`}
                    aria-label={`Watch ${s.name}`}
                >
                    <h2>
                        <RoomName name={s.name} />
                    </h2>
                </a>
                <div class="info">
                    <NowStreaming room={s.pretalxRoom} />
                </div>
                <div class="row">
                    <a href={`/watch/${s.slug}`}>
                        <img src="/watch/play.svg" alt="" />
                        Watch &amp; full schedule
                    </a>
                </div>
                <div class="row">
                    <a
                        href={matrixTo(s.chat)}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img src="/watch/matrix.svg" alt="" />
                        Join the chat
                    </a>
                </div>
                <div class="row">
                    <a
                        href={cccStream(s.ccc)}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img src="/watch/voctocat.svg" alt="" />
                        Open on media.ccc.de
                    </a>
                </div>
            </div>
        ))}
    </div>
    {space && <ChatLinks />}
</div>
