---
import SponsorsGrid from "./SponsorsGrid.astro";
import WatchCard from "./WatchCard.astro";
import Pill from "./Pill.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { CCC_CONFERENCE } from "../data/streams";

const talks_collection = await getCollection("talks");
const all_talks = talks_collection.toSorted((a,b) => new Date(a.data.Start).valueOf() - new Date(b.data.Start).valueOf());
const days: { day: { label: string, suffix: string }, talks: CollectionEntry<"talks">[] }[] = [];

function incrementDate(tomorrow:Date, days:number) {
    return tomorrow.setDate(tomorrow.getDate() + days);
}

function ordinal(n:number) {
    if (n >= 11 && n <= 13) return 'th';
    return ({ 1: 'st', 2: 'nd', 3: 'rd' } as {[index: number]:string})[n % 10] ?? 'th';
}

const conferenceTimeZone = 'Europe/Stockholm';

function formatDay(day:Date) {
    const dow = day.toLocaleDateString('en-GB', { weekday: 'long', timeZone: conferenceTimeZone });
    const date = Number(day.toLocaleDateString('en-GB', { day: 'numeric', timeZone: conferenceTimeZone }));
    return { label: dow + ' ' + date, suffix: ordinal(date) };
}

// Tracks in the order they are listed and sorted. Unlisted tracks come last.
const track_order = [
    "Keynote",
    "Public Sector",
    "Public Sector sponsored by Element",
    "Healthcare sponsored by CGM",
    "Cryptography",
    "Matrix Inside",
    "In Practice",
    "Digital Sovereignty",
    "Growing a Network",
    "Next Gen Spec",
    "Foundation",
    "Lightning Talks",
    "Workshop"
];

function rankOf(track: string | undefined) {
    if (track === undefined) return track_order.length + 1;
    const rank = track_order.indexOf(track);
    return rank === -1 ? track_order.length : rank;
}

function compareTrack(a: CollectionEntry<"talks">,b: CollectionEntry<"talks">) {
    return rankOf(a.data.Track?.en) - rankOf(b.data.Track?.en);
}

// Conference days, 20th to 23rd October 2026. Days without talks are not shown.
for (let i = 0; i < 4; i++) {
    const day = all_talks.filter((a: CollectionEntry<"talks">) =>
        new Date(a.data.Start).valueOf() >= incrementDate(new Date("2026-10-20T00:00+02:00"),i) &&
        new Date(a.data.Start).valueOf() < incrementDate(new Date("2026-10-21T00:00+02:00"),i)
    ).toSorted(compareTrack);
    if (day.length > 0) days.push({ day: formatDay(new Date(day[0].data.Start)), talks: day });
}

const filter_tracks = [...new Set(all_talks.flatMap((talk) => talk.data.Track ? [talk.data.Track.en] : []))]
    .toSorted((a, b) => rankOf(a) - rankOf(b));
---

<style lang="scss">
    section {
        padding: clamp(2.5rem, 10vw, 5rem) 1.5rem;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    .content-wrapper#talks {
        max-width: 1122px;
    }

    #hero {
        background-image: url(/grey-repeating-lines.svg);
        display: block;
        padding-bottom: 30px;
        padding-top: 30px;
    }

    h1 {
        font-size: 2.5rem;
        line-height: 120%;
        text-align: center;
    }

    h2 {
        font-size: 2rem;
        color: var(--fg-color);
        font-size: 2rem;
        line-height: 120%;
    }

    a {
        color: var(--link-color);
        text-decoration: none;
    }

    #filters {
        display: flex;
        flex-wrap: wrap;
        gap: .5em;
        justify-content: center;
    }

    .date-separator {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 48px;
        margin-bottom: 24px;

        .date {
            flex: none;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-secondary)
        }

        .line {
            flex: 1;
            height: 0px;
            border-top: 2px solid var(--border);
        }
    }

    .talks-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        row-gap: 48px;
        column-gap: 24px;
    }

    #info {
        background-image: url(/grey-repeating-lines.svg);
    }

    .hidden {
        display: none;
    }

    .empty-section {
        color: var(--text-secondary);
        font-size: 1.25rem;
        text-align: center;
    }

    @media (min-width: 768px) {
        .empty-section {
            font-size: 2rem;
            margin-bottom: 48px;
        }
    }
</style>

<style is:global>
    #filters .active {
        border: 2px solid white;
    }

    .no-js {
        display: none !important;
    }
</style>

<section id="hero">
    <div class="content-wrapper">
        <h1>Watch the talks</h1>
    </div>
</section>

<section id="recordings">
    <div class="content-wrapper no-js">
        <div id="filters">
            {filter_tracks.map((track) => (
                <Pill Type="button" label={track} />
            ))}
        </div>
    </div>
    <div class="content-wrapper" id="talks">
        {days.map(({ day, talks }) => (
        <div class="date-separator">
            <div class="date">{day.label}<sup>{day.suffix}</sup> October</div>
            <div class="line"></div>
        </div>
        <div class="hidden empty-section">
            There are no talks for this day that match the filters.
        </div>
        <div class="talks-grid">
            {talks.map((talk) => (
                <WatchCard talk={talk} />
            ))}
        </div>
        ))}
        {days.length === 0 && <p class="empty-section">No recordings are available yet.</p>}
    </div>
</section>

<section id="info">
    <div class="content-wrapper">
        <p>
            All recordings are available on <a
                href={`https://media.ccc.de/c/${CCC_CONFERENCE}`}
                >media.ccc.de</a
            >.
        </p>
        <p>
            All videos and slides linked or published here are available under <a
                href="https://creativecommons.org/licenses/by-sa/4.0/"
            >CC BY-SA 4.0</a>.
        </p>
    </div>
</section>

<section id="sponsors">
    <SponsorsGrid />
</section>

<script>
    // Elements, that require JavaScript to work have the "no-js" class.
    // This class sets display = none.
    // In <script> the class is removed, so that the elements show up.
    const removeNoJs = () => {
        document.querySelectorAll('.no-js').forEach((element) => {
            element.classList.remove("no-js")
        })
    }
    removeNoJs();

    // Filter logic
    type TalkSection = {
        emptySectionElement: HTMLElement;
        talksGrid: HTMLElement;
        talkElements: HTMLElement[];
    }

    const talksElement = document.getElementById("talks");
    let talkSections : TalkSection[] = [];

    if (talksElement !== null) {
        // Find triples of empty section elements, talks grid and the talk elements inside of the grid
        let emptySectionElement : HTMLElement | null = null;

        Array.from(talksElement.children).forEach((talkElement) => {
            if (!(talkElement instanceof HTMLElement)) {
                return;
            }

            if (talkElement.classList.contains("empty-section")) {
                emptySectionElement = talkElement;
            }

            if (talkElement.classList.contains("talks-grid") && emptySectionElement !== null) {
                talkSections.push({
                    emptySectionElement,
                    talksGrid: talkElement,
                    talkElements: Array.from(talkElement.children).filter((element) => element instanceof HTMLElement),
                });
                emptySectionElement = null;
            }
        })
    }

    const filterPillElements = document.querySelectorAll("#filters .pill")
    const talkElements = document.querySelectorAll<HTMLElement>("#recordings .talk-card")

    const getActiveTracks = (): string[] => {
        const activePills = Array.from(filterPillElements)
            .filter(pill => pill.classList.contains("active"));
        return activePills.map((pill) => {
            return Array.from(pill.classList.values())
                .filter(cls => cls !== "pill" && cls !== "active")[0];
        })
    }

    const applyFilters = () => {
        const activeTracks = getActiveTracks();
        talkElements.forEach((recordingElement) => {
            if (
                // No filter active
                activeTracks.length === 0
                // Track class is in active tracks
                || activeTracks.some(activeTrack => recordingElement.classList.contains(activeTrack))) {
                recordingElement.style.display = 'flex'
                return;
            }

            recordingElement.style.display = 'none';
        });

        // Set element visibilities.
        // If a day does not have at least one talk then
        // hide the talks grid and display a placeholder.
        talkSections.forEach((talkSection) => {
            const allHidden = talkSection.talkElements.every((talkElement) => {
                return talkElement.style.display === 'none';
            });

            talkSection.emptySectionElement.style.display = allHidden ? 'block' : 'none';
            talkSection.talksGrid.style.display = allHidden ? 'none' : 'grid';
        });
    }

    const handleFilterPillClicked = (event: Event) => {
        const target = event.currentTarget as HTMLElement;
        target.classList.toggle("active");
        applyFilters();
    }

    const setUpTracksFilter = () => {
        filterPillElements.forEach((filterPill) => {
            filterPill.addEventListener("click", handleFilterPillClicked);
        })
    }

    setUpTracksFilter();
</script>
