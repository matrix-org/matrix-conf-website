---
const {
	appStoreUrl,
	appStoreAlt = "Download app from the Apple App Store.",
	googlePlayUrl,
	googlePlayAlt = "Download app from the Google Play Store."
} = Astro.props;
---

<style>
.apps-row {
    display: flex;
    gap: 1rem;
}

.apps-row img {
    margin-block: 2rem;
    border-radius: 0;
    transition: transform 0.05s ease-in;
}

.apps-row img:hover {
    transform: scale(1.1);
}
</style>

<div class="apps-row">
  <a href={ appStoreUrl }>
      <img
          src="/download-app-store.svg"
          alt={ appStoreAlt }
          width="180"
          height="60"
      />
  </a>
  <a href={ googlePlayUrl }>
      <img
          src="/download-google-play.svg"
          alt={ googlePlayAlt }
          width="200"
          height="60"
      />
  </a>
</div>
