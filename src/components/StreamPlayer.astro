---
// Placeholder until the room has a session on (from the pretalx schedule), then the CCC player.
interface Props { room: number; src: string; title: string; }
const { room, src, title } = Astro.props;
---

<style>
    .player { aspect-ratio: 16 / 9; width: 100%; border: 1px solid #d2d2d2; background: #000; }
    .placeholder { display: grid; place-content: center; background: url("/grey-repeating-lines.svg"); text-align: center; padding: 1.5rem; }
    .placeholder div { background: #000; padding: 1.5rem 2rem; }
    .placeholder h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
    .placeholder p { margin: 0; }
    iframe { display: block; }
    @media (max-width: 600px) {
        .placeholder { padding: 0.75rem; }
        .placeholder div { padding: 1rem; }
        .placeholder h2 { font-size: 1.125rem; }
    }
</style>
<div class="player placeholder" data-room={room} data-src={src} data-title={title}>
    <div>
        <h2>Nothing is streaming right now</h2>
        <p>The player appears here when the next talk in this room starts.</p>
    </div>
</div>
<noscript><iframe class="player" src={src} title={title} allowfullscreen></iframe></noscript>
<script>
    import { loadSchedule } from "../scripts/schedule";

    const LEAD = 15 * 60_000; // show the player a bit before a talk starts
    const el = document.querySelector<HTMLElement>(".player.placeholder[data-src]")!;

    function mount() {
        const f = document.createElement("iframe");
        f.className = "player";
        f.src = el.dataset.src!;
        f.title = el.dataset.title!;
        f.allowFullscreen = true;
        el.replaceWith(f);
        clearInterval(timer);
    }
    async function check() {
        const rooms = await loadSchedule().catch(() => undefined);
        if (!rooms) return mount(); // schedule unreachable: don't hide a possibly live stream
        const now = Date.now();
        if (rooms.get(Number(el.dataset.room))?.sessions.some((s) => now >= +s.start - LEAD && now < +s.end)) mount();
    }
    const timer = setInterval(check, 60_000);
    check();
</script>
