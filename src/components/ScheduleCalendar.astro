---
// Live schedule of all rooms as a calendar per day: rooms side by side, tiles as tall as the talks are long.
import "../styles/schedule.css";
import "../styles/schedule-calendar.css";
import { pretalxSchedulePage } from "../data/pretalx";
import ConferenceSchedule from "./schedule/ConferenceSchedule";

interface Props {
    /** Sessions without a pretalx page (breaks, hackathon, parties): title keyword -> link. */
    links?: Record<string, string>;
}
const { links = {} } = Astro.props;
---

<ConferenceSchedule client:only="preact" links={links}>
    <p slot="fallback">
        <a href={pretalxSchedulePage}>Open the full schedule on the CfP site</a>
    </p>
</ConferenceSchedule>
