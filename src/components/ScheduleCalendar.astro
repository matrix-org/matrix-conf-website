---
// Live schedule of all rooms as a calendar per day: rooms side by side, tiles as tall as the talks are long.
import "../styles/schedule.css";
import "../styles/schedule-calendar.css";

interface Props {
    /** Sessions without a pretalx page (breaks, hackathon, parties): title keyword -> link. */
    links?: Record<string, string>;
}
const { links = {} } = Astro.props;
---

<div
    class="schedule-list"
    role="region"
    aria-label="Conference schedule"
    data-links={JSON.stringify(links)}
></div>
<script>
    import { mountSchedule } from "../scripts/schedule-mount";
    import { scheduleDays } from "../scripts/schedule-days";
    import { calendarHtml } from "../scripts/schedule-calendar";
    import { initRoomHints } from "../scripts/schedule-hints";
    import type { Room } from "../scripts/schedule";

    /**
     * Picks every room, in pretalx's display order.
     *
     * @param all Every room known to the loaded schedule, keyed by pretalx room id.
     * @returns All rooms, sorted by {@link Room.order}.
     */
    function pickAllRooms(all: Map<number, Room>): Room[] {
        return [...all.values()].sort(
            (roomA, roomB) => roomA.order - roomB.order,
        );
    }

    /**
     * Renders every room's schedule as a calendar, day by day.
     *
     * @param rooms Rooms picked by {@link pickAllRooms}.
     * @param links Map from a title keyword to a URL, passed through to {@link calendarHtml}.
     * @param now Time to render as "now", as milliseconds since the epoch.
     * @returns HTML for every day that has sessions in any room.
     */
    function buildCalendarDays(
        rooms: Room[],
        links: Record<string, string>,
        now: number,
    ): string {
        return scheduleDays(rooms)
            .map((day) => day.heading + calendarHtml(rooms, day, now, links))
            .join("");
    }

    mountSchedule(pickAllRooms, buildCalendarDays);
    initRoomHints();
</script>
