---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pill from "../../components/Pill.astro";
import SponsorsGrid from "../../components/SponsorsGrid.astro";
import { slidesFilename, talkSlug, type Talk } from "../../data/talks";
import YouTubeIcon from "../../img/YouTube.svg";

export async function getStaticPaths() {
    const talks = await getCollection("talks");
    return talks.map((talk) => ({
        params: { talk: talkSlug(talk) },
        props: { talk },
    }));
}

interface Props {
    talk: Talk;
}

const { talk } = Astro.props;
const { ID, Abstract, Track, Room, Start, youtube, mediaCccDe } = talk.data;
const title = talk.data["Proposal title"];
const speakers = talk.data["Speaker names"].join(", ");
const slides = slidesFilename(talk);
const when = new Date(Start).toLocaleString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Europe/Stockholm",
});
---

<style lang="scss">
    section:nth-child(even) {
        background-color: #1a1a1a;
    }

    .content-wrapper {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 2rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    @media (max-width: 800px) {
        .content-wrapper {
            grid-template-columns: 1fr;
        }
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .back {
        font-weight: 700;
    }

    h1 {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        margin: 0;
    }

    .speakers {
        font-size: 1.125rem;
        font-weight: 700;
    }

    .when {
        color: var(--secondary-color);
        font-size: 0.875rem;
        text-transform: uppercase;
    }

    .talk-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .abstract {
        font-size: 1.125rem;
        line-height: 1.4;
        margin: 0;
        white-space: pre-line;
    }

    .side {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-self: start;
    }

    .panel {
        border: 1px solid #636569;
        background: #000;
    }

    .panel > * {
        align-items: center;
        display: flex;
        gap: 12px;
        min-height: 3.5rem;
        padding-inline: 24px;
    }

    .panel > *:not(:first-child) {
        border-top: 1px solid #636569;
    }

    .panel a {
        color: var(--link-color);
        text-decoration: none;
    }

    .panel a:hover {
        background-color: #262626;
    }

    .panel p {
        font-size: 1rem;
        margin: 0;
    }

    .panel img,
    .panel :global(svg) {
        flex: none;
        height: 24px;
        width: 24px;
    }

    .license {
        font-size: 1rem;
        margin: 0;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    .license a {
        font-weight: 700;
    }
</style>

<BaseLayout
    pageTitle={`${title} – The Matrix Conference`}
    description={Abstract.split("\n")[0]}
>
    <section id="talk">
        <div class="content-wrapper">
            <div class="text">
                <a class="back" href={`/vod#${talkSlug(talk)}`}>← All talks</a>
                <h1>{title}</h1>
                <div class="speakers">{speakers}</div>
                <div class="when">{when}</div>
                <div class="talk-pills">
                    {Track && <Pill Type="div" label={Track.en} />}
                    <Pill Type="div" label={Room.en} />
                </div>
                <p class="abstract">{Abstract}</p>
            </div>
            <div class="side">
                <Image
                    src={`/talks/thumbnail_${ID}.avif`}
                    alt=""
                    height="900"
                    width="1600"
                />
                <div class="panel">
                    {mediaCccDe && (
                        <a href={mediaCccDe} target="_blank" rel="noopener noreferrer">
                            <img src="/watch/voctocat.svg" alt="" />
                            Watch on media.ccc.de
                        </a>
                    )}
                    {youtube && (
                        <a href={youtube} target="_blank" rel="noopener noreferrer">
                            <YouTubeIcon />
                            Watch on YouTube
                        </a>
                    )}
                    {!mediaCccDe && !youtube && <p>Recording not available</p>}
                    {slides
                        ? <a href={`/slides/slides_${ID}.pdf`} download={slides}><img src="/watch/slides-icon.svg" alt="" />View slides</a>
                        : <p>Slides not available</p>}
                </div>
            </div>
        </div>
    </section>

    <section id="license">
        <p class="license">
            All videos and slides linked or published here are available under <a
                href="https://creativecommons.org/licenses/by-sa/4.0/"
            >CC BY-SA 4.0</a>.
        </p>
    </section>

    <section id="sponsors">
        <SponsorsGrid />
    </section>
</BaseLayout>
