---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndexHero from "../components/IndexHero.astro";
import Teaser2026 from "../components/Teaser2026.astro";
import Conf2025 from "../components/Conf2025.astro";
import Talks2025 from "../components/Talks2025.astro";
import WhatsNext from "../components/WhatsNext.astro";
import SponsorsGrid from "../components/SponsorsGrid.astro";
---

<style>
    #hero {
        padding: 0;
    }

    #matrix-conf-2025, #teaser-2026 {
        background-image: url("/grey-repeating-lines.svg");
    }

	.content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    h2 {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin: 0;
    }
</style>
<BaseLayout
    pageTitle="The Matrix Conference"
    description="Come along to see the latest and greatest progress in the Matrix world! From huge government deployments to the latest innovations, hang out with your peers to share the best learning, insights, projects and tips!"
    colorstripe={false}
>
    <section id="hero">
        <IndexHero />
    </section>
    <section id="teaser-2026">
        <Teaser2026 />
    </section>
    <section id="sponsors">
		<SponsorsGrid />
    </section>
    <section id="matrix-conf-2025">
        <Conf2025 />
        <Talks2025 />
    </section>
    <section id="whats-next">
        <WhatsNext />
    </section>
</BaseLayout>
