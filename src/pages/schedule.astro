---
import RoughSchedule from "../components/RoughSchedule.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Talks2025 from "../components/Talks2025.astro";
import PrimaryCta from "../components/PrimaryCta.astro";
import ScheduleCalendar from "../components/ScheduleCalendar.astro";
---

<style>
    .content-wrapper {
        max-width: var(--max-page-width);
        margin-inline: auto;
    }

    .content-wrapper.wide {
        max-width: 1122px;
    }

    .box {
        border: 1px solid #636569;
        padding: 20px;
        background-color: var(--bg-color);
    }

    .items {
        max-width: var(--max-page-width);
        margin-inline: auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 2rem;
    }

    .item {
        min-width: 0;
        overflow-wrap: anywhere; /* the long export URLs must not widen the page */
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    @media (min-width: 800px) {
        .smol {
            flex-basis: 40%;
        }
    }

    section:nth-child(even) {
        background-image: url("/grey-repeating-lines.svg");
    }

    /* the session tiles need a plain background, unlike the old pretalx widget */
    #full-schedule {
        background-image: none;
    }

    h2 {
        font-size: 2rem;
        font-weight: 700;
    }

    p {
        font-size: 1.125rem;
        margin-block: 1rem;
    }
</style>
<BaseLayout
    pageTitle="Schedule of The Matrix Conference"
    description="Whether you want to hear how an organization deployed Matrix at scale or learn what the engineers are doing to improve the protocol, The Matrix Conference has a track for you."
>
    <section id="schedule">
        <RoughSchedule />
        <div class="content-wrapper">
            <p>
                Stay tuned by following us on <a href="https://matrix.org/blog/"
                    >the Matrix Blog</a
                >, our <a href="https://uk.linkedin.com/company/matrix-org"
                    >LinkedIn account</a
                > or by <a href="https://mastodon.matrix.org/@matrix"
                    >following Matrix.org on the fediverse</a
                >!
            </p>
        </div>
    </section>
    <section id="full-schedule">
        <div class="content-wrapper wide">
            <h2 class="sr-only">Full schedule</h2>
            <p>Looking for a more detailed schedule? Check out the <a href="https://cfp.2026.matrix.org/matrix-conference-2026/schedule/">full schedule</a>.</p>
            <p>All times are local time in Malmö (Europe/Stockholm).</p>
            <ScheduleCalendar links={{ Hackathon: "/hackathon", "Welcome Party": "https://babelmalmo.se/" }} />
        </div>
        <noscript>
            <div class="pretalx-widget">
                <div class="pretalx-widget-info-message">
                    JavaScript is disabled in your browser. To access our
                    schedule without JavaScript, please <a
                        target="_blank"
                        href="https://cfp.2026.matrix.org/matrix-conference-2026/schedule/"
                        >click here</a
                    >.
                </div>
            </div>
        </noscript>
    </section>
    <section>
        <div class="items">
            <div class="item smol">
                <h2 id="giggity">Giggity</h2>
                <p>
                    If you are an Android user, we recommend using <a href="https://wilmer.gaa.st/main.php/giggity.html">Giggity</a>
                    to explore the many talks, workshops, and events that make up the Conference.
                    Already use Giggity? You can add the Conference schedule by using the following URL:
                    <a href="https://ggt.gaa.st/#url=https://cfp.2026.matrix.org/matrix-conference-2026/schedule/export/schedule.xml">
                    <code>https://ggt.gaa.st/#url=https://cfp.2026.matrix.org/matrix-conference-2026/schedule/export/schedule.xml</code></a>.
                </p>
            </div>
            <div class="item smol">
                <h2 id="other-applications">Other Applications</h2>
                <p>
                    If you don’t use Giggity, don’t worry. You can still explore the many talks, workshops, and events that make up the Conference.
                    Simply browse the Pretalx schedule, which lets you link directly to individual talks and provides data links for schedule apps.
                    You can view the Pretalx schedule here:
                    <code><a href="https://cfp.2026.matrix.org/matrix-conference-2026/schedule/">https://cfp.2026.matrix.org/matrix-conference-2026/schedule/</a></code>.
                </p>
            </div>
        </div>
    </section>
    <section id="talks-2025">
        <Talks2025 />
    </section>
    <section id="tickets">
        <div class="content-wrapper box">
            <h2>Tickets</h2>
            <p>
                Whether you want to hear how an organization deployed Matrix at scale
                or learn what the engineers are doing to improve the protocol,
                The Matrix Conference has a track for you.
            </p>
            <PrimaryCta href="/register">Get Tickets</PrimaryCta>
        </div>
    </section>
</BaseLayout>
