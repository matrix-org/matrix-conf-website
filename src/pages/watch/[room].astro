---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomName from "../../components/RoomName.astro";
import StreamNav from "../../components/StreamNav.astro";
import ChatLinks from "../../components/ChatLinks.astro";
import NowStreaming from "../../components/NowStreaming.astro";
import StreamPlayer from "../../components/StreamPlayer.astro";
import ScheduleList from "../../components/ScheduleList.astro";
import SponsorsGrid from "../../components/SponsorsGrid.astro";
import { streams, cccEmbed, cccStream } from "../../data/streams";

export function getStaticPaths() {
    return streams.map((s) => ({
        params: { room: s.slug },
        props: { stream: s },
    }));
}
const { stream } = Astro.props;
---

<style>
    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }
    h1 {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin: 0 0 0.5rem;
    } /* + 1rem gap = same 1.5rem to the picker as on /watch */
    .panel {
        padding: 20px;
        border: 1px solid #636569;
        background-color: var(--bg-color);
    }
</style>
<BaseLayout
    pageTitle={`Watch ${stream.name} live – The Matrix Conference`}
    description={`Livestream of the ${stream.name} room at The Matrix Conference 2026.`}
>
    <section id="stream">
        <div class="content-wrapper">
            <h1>
                <RoomName name={stream.name} />
            </h1>
            <StreamNav current={stream.slug} />
            <div class="panel">
                <NowStreaming room={stream.pretalxRoom} />
            </div>
            <StreamPlayer
                room={stream.pretalxRoom}
                src={`${cccEmbed(stream.ccc)}/hls/native/no-autoplay`}
                title={`${stream.name} livestream`}
            />
            <ChatLinks chat={stream.chat} ccc={cccStream(stream.ccc)} />
            <ScheduleList room={stream.pretalxRoom} />
        </div>
    </section>
    <section id="sponsors">
        <SponsorsGrid />
    </section>
</BaseLayout>
