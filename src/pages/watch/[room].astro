---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChatLinks from "../../components/ChatLinks.astro";
import NowStreaming from "../../components/NowStreaming.astro";
import StreamPlayer from "../../components/StreamPlayer.astro";
import ScheduleList from "../../components/ScheduleList.astro";
import SponsorsGrid from "../../components/SponsorsGrid.astro";
import { streams, cccEmbed, cccStream } from "../../data/streams";

export function getStaticPaths() {
    return streams.map((s) => ({ params: { room: s.slug }, props: { stream: s } }));
}
const { stream } = Astro.props;
---

<style>
    .content-wrapper { display: flex; flex-direction: column; gap: 1rem; max-width: var(--max-page-width); margin-inline: auto; }
    h1 { font-size: 2rem; font-weight: 700; text-align: center; }
    nav.rooms { display: flex; flex-wrap: wrap; justify-content: center; }
    nav.rooms a { padding: 0.75rem 1.5rem; border: 1px solid #636569; margin-inline-start: -1px; color: var(--fg-color); font-weight: 700; }
    @media (max-width: 600px) {
        nav.rooms { display: grid; grid-template-columns: 1fr 1fr; }
        nav.rooms a { margin-inline-start: 0; margin-block-start: -1px; text-align: center; }
        nav.rooms a:nth-child(even) { margin-inline-start: -1px; }
    }
    nav.rooms a:hover { background-color: #262626; text-decoration: none; }
    nav.rooms a[aria-current="page"] { background-color: #1a1a1a; box-shadow: inset 0 -3px 0 var(--link-color); }
    a { color: var(--link-color); text-decoration: none; }
    a.ccc { display: flex; align-items: center; gap: 12px; }
    a.ccc:hover { text-decoration: underline; }
</style>
<BaseLayout
    pageTitle={`Watch ${stream.name} live – The Matrix Conference`}
    description={`Livestream of the ${stream.name} room at The Matrix Conference 2026.`}
>
    <section id="stream">
        <div class="content-wrapper">
            <h1>{stream.name}</h1>
            <nav class="rooms" aria-label="Streams">
                <a href="/watch">All streams</a>
                {streams.map((s) => <a href={`/watch/${s.slug}`} aria-current={s === stream ? "page" : undefined}>{s.name}</a>)}
            </nav>
            <ChatLinks chat={stream.chat} />
            <NowStreaming room={stream.pretalxRoom} />
            <StreamPlayer room={stream.pretalxRoom} src={`${cccEmbed(stream.slug)}/hls/native/no-autoplay`} title={`${stream.name} livestream`} />
            <a class="ccc" href={cccStream(stream.slug)} target="_blank" rel="noopener noreferrer"><img src="/watch/voctocat.svg" alt="" width="24" height="24" />Open on media.ccc.de</a>
            <ScheduleList room={stream.pretalxRoom} />
        </div>
    </section>
    <section id="sponsors"><SponsorsGrid /></section>
</BaseLayout>
