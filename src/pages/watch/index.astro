---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StreamNav from "../../components/StreamNav.astro";
import StreamOverview from "../../components/StreamOverview.astro";
import VodTalks from "../../components/VodTalks.astro";
import { watchMode } from "../../data/streams";

const vod = watchMode === "vod";
---

<style>
    .content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: var(--max-page-width);
        margin-inline: auto;
    }
    h1 {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin: 0;
    }
</style>
<BaseLayout
    pageTitle={vod ? "Watch the Conference Recordings" : "Watch The Matrix Conference Live"}
    description={vod
        ? "Follow along the Matrix Conference even if you couldn't make it to Malmö"
        : "Follow The Matrix Conference 2026 live from anywhere: one livestream per room, plus a Matrix chat room for each."}
>
    {vod ? (
        <VodTalks />
    ) : (
        <section id="streams">
            <div class="content-wrapper">
                <h1>Watch</h1>
                <StreamNav />
                <StreamOverview />
            </div>
        </section>
    )}
</BaseLayout>
